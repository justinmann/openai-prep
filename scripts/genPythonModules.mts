// Regenerates shared/guide/pythonModules.ts from the installed Pyodide:
//   npx tsx scripts/genPythonModules.mts
// Stdlib: sys.stdlib_module_names that import in Pyodide (or that Pyodide
// ships as separately loaded modules). Packages: import names from the lock.
import { readFileSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import { loadPyodide } from 'pyodide';

const dir = path.dirname(createRequire(import.meta.url).resolve('pyodide'));
const lock = JSON.parse(
  readFileSync(path.join(dir, 'pyodide-lock.json'), 'utf8'),
) as {
  packages: Record<string, { package_type?: string; imports?: string[] }>;
};
const pkgs = Object.values(lock.packages);
const separate = new Set(
  pkgs
    .filter((p) => p.package_type === 'cpython_module')
    .flatMap((p) => p.imports ?? []),
);
const py = await loadPyodide({ indexURL: dir });
const stdlib = py.runPython(String.raw`
import sys, importlib, json
ok = []
for name in sorted(sys.stdlib_module_names):
    if name.startswith('_') or name in ('this', 'antigravity'):
        continue
    try:
        importlib.import_module(name)
        ok.append(name)
    except Exception:
        pass
json.dumps(ok)
`) as string;
const stdNames = new Set(JSON.parse(stdlib) as string[]);
for (const s of separate)
  if (s !== 'test' && s !== 'pydoc_data') stdNames.add(s);
const packages = [
  ...new Set(
    pkgs
      .filter((p) => p.package_type === 'package')
      .flatMap((p) => p.imports ?? [])
      .filter((n) => !n.startsWith('_') && !stdNames.has(n)),
  ),
].sort((a, b) => a.localeCompare(b));

const out = `// Generated by scripts/genPythonModules.mts from pyodide ${py.version}. Do not edit.

export const pythonStdlib: string[] = ${JSON.stringify([...stdNames].sort(), null, 2)};

export const pyodidePackages: string[] = ${JSON.stringify(packages, null, 2)};
`;
writeFileSync('shared/guide/pythonModules.ts', out);
console.log(`stdlib ${stdNames.size}, packages ${packages.length}`);

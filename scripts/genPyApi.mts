// Regenerates shared/guide/pyApi.ts: every public method and attribute of the
// basic Python types and common interview modules, read from the Pyodide
// runtime the app runs (signatures from inspect, docs from docstrings).
//   npx tsx scripts/genPyApi.mts
import { writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import { loadPyodide } from 'pyodide';

const dir = path.dirname(createRequire(import.meta.url).resolve('pyodide'));
const py = await loadPyodide({ indexURL: dir });
const json = py.runPython(String.raw`
import builtins, collections, heapq, bisect, math, itertools, functools, inspect, json, re, sys

def first_sentence(doc):
    if not doc:
        return ''
    lines = [l.strip() for l in doc.strip().split('\n')]
    # Skip a leading signature line like "split(self, /, sep=None)".
    while lines and ('(' in lines[0] and (lines[0].rstrip().endswith(')') or ' -> ' in lines[0]) or lines[0].startswith('--')):
        lines = lines[1:]
    text = ' '.join(l for l in lines if l)
    text = text.split('\n\n')[0]
    m = re.match(r'(.+?[.!?])(\s|$)', text)
    return (m.group(1) if m else text)[:200]

def sig_of(name, obj):
    try:
        s = str(inspect.signature(obj))
        s = s.replace('(self, /, ', '(').replace('(self, /)', '()').replace('(self, ', '(').replace('(self)', '()').replace('(cls, ', '(')
        s = s.replace(', /)', ')').replace('(/)', '()').replace('(/, ', '(')
        return name + s
    except (TypeError, ValueError):
        doc = (obj.__doc__ or '').strip().split('\n')[0]
        return doc if doc.startswith(name + '(') else name + '(...)'

def members(obj, prefix, include=None):
    out = []
    for name in sorted(dir(obj)):
        if name.startswith('_'):
            continue
        if include is not None and name not in include:
            continue
        try:
            v = getattr(obj, name)
        except Exception:
            continue
        if callable(v):
            out.append({'name': name, 'sig': sig_of(name, v), 'doc': first_sentence(getattr(v, '__doc__', ''))})
        elif not inspect.ismodule(v):
            out.append({'name': name, 'sig': name + ': ' + type(v).__name__, 'doc': ''})
    return out

builtin_fns = [n for n in dir(builtins) if not n.startswith('_') and inspect.isbuiltin(getattr(builtins, n)) or n in (
    'range', 'enumerate', 'zip', 'map', 'filter', 'reversed', 'sorted', 'int', 'float', 'str', 'list', 'dict', 'set', 'tuple', 'bool', 'frozenset', 'bytes', 'object', 'type', 'slice', 'super', 'property', 'staticmethod', 'classmethod')]
skip = {'breakpoint', 'copyright', 'credits', 'exit', 'help', 'license', 'quit', 'exec', 'eval', 'compile', '__build_class__', '__import__', 'memoryview', 'bytearray', 'complex'}
groups = [
    {'title': 'Built-in functions', 'prefix': '', 'members': [m for m in members(builtins, '', set(builtin_fns) - skip)]},
    {'title': 'str', 'prefix': 's.', 'members': members(str, 's.')},
    {'title': 'int', 'prefix': 'n.', 'members': members(int, 'n.')},
    {'title': 'float', 'prefix': 'x.', 'members': members(float, 'x.')},
    {'title': 'list', 'prefix': 'a.', 'members': members(list, 'a.')},
    {'title': 'dict', 'prefix': 'd.', 'members': members(dict, 'd.')},
    {'title': 'set', 'prefix': 's.', 'members': members(set, 's.')},
    {'title': 'tuple', 'prefix': 't.', 'members': members(tuple, 't.')},
    {'title': 'collections.deque', 'prefix': 'q.', 'members': members(collections.deque, 'q.')},
    {'title': 'collections.Counter', 'prefix': 'c.', 'members': [m for m in members(collections.Counter, 'c.') if m['name'] not in dir(dict) or m['name'] in ('update', 'fromkeys')]},
    {'title': 'collections (module)', 'prefix': 'collections.', 'members': members(collections, '', {'Counter', 'OrderedDict', 'defaultdict', 'deque', 'namedtuple', 'ChainMap'})},
    {'title': 'heapq', 'prefix': 'heapq.', 'members': members(heapq, '')},
    {'title': 'bisect', 'prefix': 'bisect.', 'members': members(bisect, '')},
    {'title': 'math', 'prefix': 'math.', 'members': members(math, '')},
    {'title': 'itertools', 'prefix': 'itertools.', 'members': members(itertools, '')},
    {'title': 'functools', 'prefix': 'functools.', 'members': members(functools, '', {'cache', 'lru_cache', 'partial', 'reduce', 'cmp_to_key', 'total_ordering', 'wraps', 'cached_property'})},
    {'title': 'json', 'prefix': 'json.', 'members': members(json, '', {'dumps', 'loads', 'dump', 'load', 'JSONDecodeError'})},
]
json.dumps({'version': sys.version.split()[0], 'groups': groups})
`) as string;
const { version, groups } = JSON.parse(json) as {
  version: string;
  groups: { title: string; members: unknown[] }[];
};
writeFileSync(
  'shared/guide/pyApi.ts',
  `// GENERATED by scripts/genPyApi.mts from Python ${version} (Pyodide). Do not edit.
import type { ApiGroup } from './types';

export const pyApi: ApiGroup[] = ${JSON.stringify(groups, null, 2)};
`,
);
console.log(groups.map((g) => `${g.title}: ${g.members.length}`).join('\n'));
